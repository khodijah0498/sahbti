{
  "expo": {
    "name": "sahbti",
    "slug": "sahbti",
    "version": "1.0.0",
    "scheme": "sahbti",
    
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
    },
    "plugins": ["expo-router"]
  }
}
